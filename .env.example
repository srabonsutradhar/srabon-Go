# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google AdSense (optional — required to display real Google AdSense ads)
# VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
# VITE_ADSENSE_SLOT_STUDIO="1234567890"
# VITE_ADSENSE_SLOT_GRID="0987654321"

# Google Ads Conversion / Tag ID (optional, e.g. AW-XXXXXXXXXX)
# VITE_GOOGLE_ADS_ID="AW-XXXXXXXXXX"

# Optional backend API base URL if frontend is hosted statically (e.g. GitHub Pages)
# VITE_API_BASE_URL="https://your-backend-server.example.com"

# Optional Gemini Flash-Lite TTS quota governor (matches AI Studio rate limit chart)
# TTS_RPM_LIMIT=10
# TTS_TPM_LIMIT=10000
# TTS_RPD_LIMIT=0
