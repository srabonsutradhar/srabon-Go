rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 140 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidReferralCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function isValidCouponCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 20 && code.matches('^[A-Z0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'srabon10010@gmail.com';
    }

    function isValidUserVoicePreferences(data, expectedUid) {
      return data.keys().hasAll(['uid', 'favorites', 'plan', 'dailyCount', 'lastUsageDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'favorites',
          'plan', 'proPackageType', 'proExpiresAt', 'dailyCount', 'lastUsageDate',
          'referralCode', 'bonusCredits', 'referralCount',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == expectedUid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.favorites is list
        && data.favorites.size() <= 50
        && (data.favorites.size() == 0 || (data.favorites[0] is string && data.favorites[0].size() >= 1 && data.favorites[0].size() <= 64))
        && data.plan is string
        && data.plan in ['free', 'pro']
        && (!('proPackageType' in data) || (data.proPackageType is string && data.proPackageType in ['monthly', 'yearly']))
        && (!('proExpiresAt' in data) || data.proExpiresAt is timestamp)
        && data.dailyCount is int
        && data.dailyCount >= 0
        && data.dailyCount <= 100000
        && data.lastUsageDate is string
        && data.lastUsageDate.size() == 10
        && data.lastUsageDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('referralCode' in data) || isValidReferralCode(data.referralCode))
        && (!('bonusCredits' in data) || (data.bonusCredits is int && data.bonusCredits >= 0 && data.bonusCredits <= 1000000))
        && (!('referralCount' in data) || (data.referralCount is int && data.referralCount >= 0 && data.referralCount <= 100000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralCodeMap(data, expectedCode) {
      return data.keys().hasAll(['code', 'uid', 'createdAt'])
        && data.keys().hasOnly(['code', 'uid', 'createdAt'])
        && isValidReferralCode(data.code)
        && data.code == expectedCode
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.createdAt is timestamp;
    }

    function isValidReferralClaim(data, expectedReferredUid) {
      return data.keys().hasAll(['referredUid', 'referrerUid', 'referralCode', 'rewardCredits', 'createdAt'])
        && data.keys().hasOnly(['referredUid', 'referrerUid', 'referralCode', 'rewardCredits', 'createdAt'])
        && isValidId(data.referredUid)
        && data.referredUid == expectedReferredUid
        && data.referredUid == request.auth.uid
        && isValidId(data.referrerUid)
        && data.referrerUid != request.auth.uid
        && isValidReferralCode(data.referralCode)
        && data.rewardCredits is int
        && data.rewardCredits == 10
        && data.createdAt is timestamp;
    }

    function isValidProRequest(data) {
      return data.keys().hasAll(['uid', 'paymentMethod', 'senderNumber', 'transactionId', 'amountText', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'userEmail', 'userName', 'packageType', 'paymentMethod', 'senderNumber', 'transactionId', 'amountText', 'note', 'status', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 254))
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 120))
        && (!('packageType' in data) || (data.packageType is string && data.packageType in ['monthly', 'yearly']))
        && data.paymentMethod is string
        && data.paymentMethod in ['bKash', 'Nagad', 'Rocket', 'Bank / Other']
        && data.senderNumber is string
        && data.senderNumber.size() >= 4
        && data.senderNumber.size() <= 30
        && data.transactionId is string
        && data.transactionId.size() >= 3
        && data.transactionId.size() <= 64
        && data.amountText is string
        && data.amountText.size() >= 1
        && data.amountText.size() <= 40
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && data.status is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBillingConfig(data) {
      return data.keys().hasAll(['feeAmount', 'paymentMethod', 'paymentAccount', 'instructions', 'freeDailyLimit', 'updatedAt'])
        && data.keys().hasOnly(['feeAmount', 'monthlyFee', 'yearlyFee', 'paymentMethod', 'paymentAccount', 'instructions', 'freeDailyLimit', 'apiBaseUrl', 'updatedAt'])
        && data.feeAmount is string
        && data.feeAmount.size() >= 1
        && data.feeAmount.size() <= 40
        && (!('monthlyFee' in data) || (data.monthlyFee is string && data.monthlyFee.size() >= 1 && data.monthlyFee.size() <= 40))
        && (!('yearlyFee' in data) || (data.yearlyFee is string && data.yearlyFee.size() >= 1 && data.yearlyFee.size() <= 40))
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 60
        && data.paymentAccount is string
        && data.paymentAccount.size() <= 80
        && data.instructions is string
        && data.instructions.size() <= 500
        && data.freeDailyLimit is int
        && data.freeDailyLimit >= 1
        && data.freeDailyLimit <= 100
        && (!('apiBaseUrl' in data) || (data.apiBaseUrl is string && data.apiBaseUrl.size() <= 200 && data.apiBaseUrl.matches('^(|https://([a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,24}(:[0-9]{1,5})?(/[a-zA-Z0-9._/-]*)?|http://(localhost|127\\.0\\.0\\.1)(:[0-9]{1,5})?(/[a-zA-Z0-9._/-]*)?)$')))
        && data.updatedAt is timestamp;
    }

    function isValidSalonPrice(val) {
      return val is int && val >= 0 && val <= 50000;
    }

    function isValidSalonConfig(data) {
      return data.keys().hasAll([
          'salonName', 'currencySymbol',
          'haircutPrice', 'beardTrimPrice', 'shavePrice',
          'hairColorPrice', 'facialPrice', 'comboPrice', 'bookingFee',
          'address', 'phone', 'openHours', 'isBookingOpen', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'salonName', 'currencySymbol',
          'haircutPrice', 'beardTrimPrice', 'shavePrice',
          'hairColorPrice', 'facialPrice', 'comboPrice', 'bookingFee',
          'address', 'phone', 'openHours', 'isBookingOpen', 'updatedAt'
        ])
        && data.salonName is string
        && data.salonName.size() >= 1
        && data.salonName.size() <= 100
        && data.currencySymbol is string
        && data.currencySymbol.size() >= 1
        && data.currencySymbol.size() <= 10
        && isValidSalonPrice(data.haircutPrice)
        && isValidSalonPrice(data.beardTrimPrice)
        && isValidSalonPrice(data.shavePrice)
        && isValidSalonPrice(data.hairColorPrice)
        && isValidSalonPrice(data.facialPrice)
        && isValidSalonPrice(data.comboPrice)
        && isValidSalonPrice(data.bookingFee)
        && data.address is string
        && data.address.size() <= 200
        && data.phone is string
        && data.phone.size() <= 30
        && data.openHours is string
        && data.openHours.size() <= 80
        && data.isBookingOpen is bool
        && data.updatedAt is timestamp;
    }

    function isValidSalonBooking(data) {
      return data.keys().hasAll([
          'uid', 'customerName', 'customerPhone',
          'serviceKey', 'serviceTitle', 'servicePrice', 'bookingFee', 'totalPrice',
          'bookingDate', 'timeSlot', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'customerName', 'customerPhone', 'customerEmail',
          'serviceKey', 'serviceTitle', 'servicePrice', 'bookingFee',
          'couponCode', 'discountPercent', 'discountAmount', 'totalPrice',
          'bookingDate', 'timeSlot', 'serialNumber', 'notes', 'status',
          'completionSignaturePath', 'completionSignerName', 'completedAt',
          'autoCancelledReason', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 100
        && data.customerPhone is string
        && data.customerPhone.size() >= 6
        && data.customerPhone.size() <= 25
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 254))
        && data.serviceKey is string
        && data.serviceKey in ['haircut', 'beard', 'shave', 'color', 'facial', 'combo']
        && data.serviceTitle is string
        && data.serviceTitle.size() >= 2
        && data.serviceTitle.size() <= 100
        && isValidSalonPrice(data.servicePrice)
        && isValidSalonPrice(data.bookingFee)
        && data.totalPrice is int
        && (
          (
            !('couponCode' in data)
            && !('discountPercent' in data)
            && !('discountAmount' in data)
            && data.totalPrice == data.servicePrice + data.bookingFee
          )
          ||
          (
            'couponCode' in data
            && 'discountPercent' in data
            && 'discountAmount' in data
            && isValidCouponCode(data.couponCode)
            && data.discountPercent is int
            && data.discountPercent >= 10
            && data.discountPercent <= 30
            && data.discountAmount is int
            && data.discountAmount >= 0
            && data.discountAmount <= data.servicePrice
            && data.discountAmount * 100 <= data.servicePrice * data.discountPercent + 50
            && data.discountAmount * 100 >= data.servicePrice * data.discountPercent - 50
            && data.totalPrice == data.servicePrice + data.bookingFee - data.discountAmount
          )
        )
        && isValidDateStr(data.bookingDate)
        && data.timeSlot is string
        && data.timeSlot.size() >= 2
        && data.timeSlot.size() <= 30
        && (!('serialNumber' in data) || (data.serialNumber is int && data.serialNumber >= 1 && data.serialNumber <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.status is string
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && (!('completionSignaturePath' in data) || (data.completionSignaturePath is string && data.completionSignaturePath.size() >= 5 && data.completionSignaturePath.size() <= 1500 && data.completionSignaturePath.matches('^M[ML0-9., ]+$')))
        && (!('completionSignerName' in data) || (data.completionSignerName is string && data.completionSignerName.size() >= 2 && data.completionSignerName.size() <= 80))
        && (!('completedAt' in data) || data.completedAt is timestamp)
        && (!('autoCancelledReason' in data) || (data.autoCancelledReason is string && data.autoCancelledReason in ['time_expired']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalonQueueSummary(data, expectedDate) {
      return data.keys().hasAll(['bookingDate', 'totalSerials', 'lastBookingId', 'updatedAt'])
        && data.keys().hasOnly(['bookingDate', 'totalSerials', 'lastBookingId', 'updatedAt'])
        && isValidDateStr(data.bookingDate)
        && data.bookingDate == expectedDate
        && data.totalSerials is int
        && data.totalSerials >= 1
        && data.totalSerials <= 500
        && isValidId(data.lastBookingId)
        && data.updatedAt is timestamp;
    }

    function isValidSalonQueueTicket(data, expectedDate, expectedBookingId) {
      return data.keys().hasAll([
          'bookingId', 'uid', 'bookingDate', 'serialNumber',
          'serviceKey', 'timeSlot', 'slotMinutes', 'status',
          'hasCompletionSignature', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'uid', 'bookingDate', 'serialNumber',
          'serviceKey', 'timeSlot', 'slotMinutes', 'status',
          'hasCompletionSignature', 'completionSignerName',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.bookingId)
        && data.bookingId == expectedBookingId
        && isValidId(data.uid)
        && isValidDateStr(data.bookingDate)
        && data.bookingDate == expectedDate
        && data.serialNumber is int
        && data.serialNumber >= 1
        && data.serialNumber <= 500
        && data.serviceKey is string
        && data.serviceKey in ['haircut', 'beard', 'shave', 'color', 'facial', 'combo']
        && data.timeSlot is string
        && data.timeSlot.size() >= 2
        && data.timeSlot.size() <= 30
        && data.slotMinutes is int
        && data.slotMinutes >= 0
        && data.slotMinutes <= 1439
        && data.status is string
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && data.hasCompletionSignature is bool
        && (!('completionSignerName' in data) || (data.completionSignerName is string && data.completionSignerName.size() >= 2 && data.completionSignerName.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalonCoupon(data, expectedUid) {
      return data.keys().hasAll(['uid', 'code', 'title', 'aiMessage', 'discountPercent', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'userEmail', 'userName',
          'code', 'title', 'aiMessage', 'discountPercent',
          'status', 'usedBookingId', 'usedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == expectedUid
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 254))
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 120))
        && isValidCouponCode(data.code)
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.aiMessage is string
        && data.aiMessage.size() >= 5
        && data.aiMessage.size() <= 240
        && data.discountPercent is int
        && data.discountPercent >= 10
        && data.discountPercent <= 30
        && data.status is string
        && data.status in ['available', 'used']
        && (!('usedBookingId' in data) || isValidId(data.usedBookingId))
        && (!('usedAt' in data) || data.usedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppIssue(data) {
      return data.keys().hasAll(['uid', 'source', 'severity', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'reporterEmail', 'reporterName',
          'source', 'severity', 'message', 'details',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && (!('reporterEmail' in data) || (data.reporterEmail is string && data.reporterEmail.size() <= 254))
        && (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 120))
        && data.source is string
        && data.source.size() >= 1
        && data.source.size() <= 60
        && data.severity is string
        && data.severity in ['error', 'warning']
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 500
        && (!('details' in data) || (data.details is string && data.details.size() <= 1000))
        && data.status is string
        && data.status in ['unread', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminFeedbackThread(data, expectedThreadId) {
      return data.keys().hasAll([
          'threadId', 'uid', 'userName', 'pageScope',
          'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByUser',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'threadId', 'uid', 'userName', 'pageScope',
          'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByUser',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.threadId)
        && data.threadId.size() >= 3
        && data.threadId == expectedThreadId
        && isValidId(data.uid)
        && data.uid.size() <= 128
        && data.userName is string
        && data.userName.size() >= 1
        && data.userName.size() <= 120
        && data.pageScope is string
        && data.pageScope in ['studio', 'salon']
        && data.lastMessage is string
        && data.lastMessage.size() >= 1
        && data.lastMessage.size() <= 500
        && data.lastSenderRole is string
        && data.lastSenderRole in ['user', 'admin']
        && data.unreadByAdmin is bool
        && data.unreadByUser is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminFeedbackMessage(data, expectedThreadId) {
      return data.keys().hasAll([
          'threadId', 'threadOwnerUid', 'uid', 'senderName',
          'senderRole', 'pageScope', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'threadId', 'threadOwnerUid', 'uid', 'senderName',
          'senderRole', 'pageScope', 'text', 'createdAt'
        ])
        && isValidId(data.threadId)
        && data.threadId == expectedThreadId
        && isValidId(data.threadOwnerUid)
        && data.threadOwnerUid.size() <= 128
        && isValidId(data.uid)
        && data.uid.size() <= 128
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 120
        && data.senderRole is string
        && data.senderRole in ['user', 'admin']
        && data.pageScope is string
        && data.pageScope in ['studio', 'salon']
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidCommunityMessage(data) {
      return data.keys().hasAll([
          'roomId', 'uid', 'senderName', 'senderRole', 'originPage', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'uid', 'senderName', 'senderRole', 'originPage', 'text', 'createdAt'
        ])
        && data.roomId is string
        && data.roomId in ['general', 'studio', 'salon']
        && isValidId(data.uid)
        && data.uid.size() <= 128
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 80
        && data.senderRole is string
        && data.senderRole in ['user', 'admin']
        && data.originPage is string
        && data.originPage in ['home', 'studio', 'ideas', 'salon', 'library']
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidSiteReview(data, expectedUid) {
      return data.keys().hasAll(['uid', 'authorName', 'rating', 'pageTag', 'comment', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'authorName', 'authorPhotoUrl',
          'rating', 'pageTag', 'comment',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == expectedUid
        && data.uid.size() <= 128
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 512 && data.authorPhotoUrl.matches('^https://[a-zA-Z0-9._~:/?#@!$&()*+,;=%-]+$')))
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.pageTag is string
        && data.pageTag in ['overall', 'studio', 'voice-clone', 'ideas', 'salon']
        && data.comment is string
        && data.comment.size() >= 4
        && data.comment.size() <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserVoicePreferences(incoming(), userId)
        && incoming().plan == 'free'
        && incoming().dailyCount == 0
        && (!('bonusCredits' in incoming()) || incoming().bonusCredits == 0)
        && (!('referralCount' in incoming()) || incoming().referralCount == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserVoicePreferences(incoming(), userId)
        && (
          ('uid' in existing() && incoming().uid == existing().uid)
          || (!('uid' in existing()) && incoming().uid == userId)
        )
        && (
          ('createdAt' in existing() && incoming().createdAt == existing().createdAt)
          || (!('createdAt' in existing()) && incoming().createdAt == request.time)
        )
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates profile, favorites, daily usage, referralCode, or consumes 1 bonusCredit
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'favorites', 'dailyCount', 'lastUsageDate', 'plan', 'referralCode', 'bonusCredits', 'createdAt', 'updatedAt'])
            && (
              ('plan' in existing() && incoming().plan == existing().plan)
              || (!('plan' in existing()) && incoming().plan == 'free')
            )
            && (
              !('referralCode' in existing())
              || ('referralCode' in incoming() && incoming().referralCode == existing().referralCode)
            )
            && (
              (!('bonusCredits' in existing()) && (!('bonusCredits' in incoming()) || incoming().bonusCredits == 0))
              || (
                'bonusCredits' in existing()
                && 'bonusCredits' in incoming()
                && (incoming().bonusCredits == existing().bonusCredits || incoming().bonusCredits == existing().bonusCredits - 1)
              )
            )
            && (
              !('lastUsageDate' in existing())
              || !('dailyCount' in existing())
              || incoming().lastUsageDate > existing().lastUsageDate
              || (incoming().lastUsageDate == existing().lastUsageDate && incoming().dailyCount >= existing().dailyCount)
            )
          )
          ||
          // Action 2: Referred friend atomically grants +10 bonusCredits & +1 referralCount to referrer
          (
            request.auth.uid != userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['bonusCredits', 'referralCount', 'updatedAt'])
            && (
              ('bonusCredits' in existing() && incoming().bonusCredits == existing().bonusCredits + 10)
              || (!('bonusCredits' in existing()) && incoming().bonusCredits == 10)
            )
            && (
              ('referralCount' in existing() && incoming().referralCount == existing().referralCount + 1)
              || (!('referralCount' in existing()) && incoming().referralCount == 1)
            )
            && !exists(/databases/$(database)/documents/referrals/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerUid == userId
          )
          ||
          // Action 3: Admin updates user plan, package expiry, or bonusCredits
          (
            isBootstrappedAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'proPackageType', 'proExpiresAt', 'dailyCount', 'lastUsageDate', 'bonusCredits', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }

    match /referralCodes/{code} {
      allow get: if isSignedIn() && isValidReferralCode(code);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidReferralCode(code)
        && isValidReferralCodeMap(incoming(), code)
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if false;
    }

    match /referrals/{referredUid} {
      allow get: if isSignedIn() && isValidId(referredUid) && (isOwner(referredUid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(referredUid)
        && isOwner(referredUid)
        && isValidReferralClaim(incoming(), referredUid)
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().referrerUid))
        && exists(/databases/$(database)/documents/referralCodes/$(incoming().referralCode))
        && get(/databases/$(database)/documents/referralCodes/$(incoming().referralCode)).data.uid == incoming().referrerUid;
      allow update: if false;
      allow delete: if false;
    }

    match /proRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidProRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(requestId)
        && isValidProRequest(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'pending'
        && incoming().status in ['approved', 'rejected']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isBootstrappedAdmin() && isValidId(requestId);
    }

    match /appConfig/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;
      allow create: if isBootstrappedAdmin()
        && isValidId(configId)
        && isValidBillingConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(configId)
        && isValidBillingConfig(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['feeAmount', 'monthlyFee', 'yearlyFee', 'paymentMethod', 'paymentAccount', 'instructions', 'freeDailyLimit', 'apiBaseUrl', 'updatedAt'])
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /salonConfig/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;
      allow create: if isBootstrappedAdmin()
        && isValidId(configId)
        && isValidSalonConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(configId)
        && isValidSalonConfig(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'salonName', 'currencySymbol',
          'haircutPrice', 'beardTrimPrice', 'shavePrice',
          'hairColorPrice', 'facialPrice', 'comboPrice', 'bookingFee',
          'address', 'phone', 'openHours', 'isBookingOpen', 'updatedAt'
        ])
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /salonBookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidSalonBooking(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && 'serialNumber' in incoming()
        && !('completionSignaturePath' in incoming())
        && !('completionSignerName' in incoming())
        && !('completedAt' in incoming())
        && !('autoCancelledReason' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/salonQueues/$(incoming().bookingDate)).data.totalSerials == incoming().serialNumber
        && getAfter(/databases/$(database)/documents/salonQueues/$(incoming().bookingDate)).data.lastBookingId == bookingId
        && existsAfter(/databases/$(database)/documents/salonQueues/$(incoming().bookingDate)/tickets/$(bookingId))
        && (
          !('couponCode' in incoming())
          || (
            exists(/databases/$(database)/documents/salonCoupons/$(request.auth.uid))
            && get(/databases/$(database)/documents/salonCoupons/$(request.auth.uid)).data.status == 'available'
            && get(/databases/$(database)/documents/salonCoupons/$(request.auth.uid)).data.code == incoming().couponCode
            && get(/databases/$(database)/documents/salonCoupons/$(request.auth.uid)).data.discountPercent == incoming().discountPercent
            && existsAfter(/databases/$(database)/documents/salonCoupons/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/salonCoupons/$(request.auth.uid)).data.status == 'used'
            && getAfter(/databases/$(database)/documents/salonCoupons/$(request.auth.uid)).data.usedBookingId == bookingId
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidSalonBooking(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (!('serialNumber' in existing()) && !('serialNumber' in incoming()))
          || ('serialNumber' in existing() && 'serialNumber' in incoming() && incoming().serialNumber == existing().serialNumber)
        )
        && (
          (
            isBootstrappedAdmin()
            && incoming().status in ['pending', 'confirmed', 'completed', 'cancelled']
            && (!('completedAt' in incoming()) || incoming().completedAt == request.time || ('completedAt' in existing() && incoming().completedAt == existing().completedAt))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'completionSignaturePath', 'completionSignerName', 'completedAt', 'autoCancelledReason', 'updatedAt'
            ])
          )
          || (
            existing().uid == request.auth.uid
            && existing().status in ['pending', 'confirmed']
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'autoCancelledReason', 'updatedAt'])
          )
          || (
            existing().uid == request.auth.uid
            && existing().status in ['confirmed', 'completed']
            && incoming().status == 'completed'
            && 'completionSignaturePath' in incoming()
            && 'completionSignerName' in incoming()
            && 'completedAt' in incoming()
            && incoming().completedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'completionSignaturePath', 'completionSignerName', 'completedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isBootstrappedAdmin() && isValidId(bookingId);
    }

    match /salonCoupons/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidSalonCoupon(incoming(), userId)
        && incoming().status == 'available'
        && !('usedBookingId' in incoming())
        && !('usedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidSalonCoupon(incoming(), userId)
        && existing().status == 'available'
        && incoming().status == 'used'
        && incoming().uid == existing().uid
        && incoming().code == existing().code
        && incoming().title == existing().title
        && incoming().aiMessage == existing().aiMessage
        && incoming().discountPercent == existing().discountPercent
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && 'usedBookingId' in incoming()
        && 'usedAt' in incoming()
        && incoming().usedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedBookingId', 'usedAt', 'updatedAt'])
        && existsAfter(/databases/$(database)/documents/salonBookings/$(incoming().usedBookingId))
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().usedBookingId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().usedBookingId)).data.couponCode == existing().code;
      allow delete: if false;
    }

    match /appIssues/{issueId} {
      allow get: if isBootstrappedAdmin() && isValidId(issueId);
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(issueId)
        && isValidAppIssue(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'unread'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(issueId)
        && isValidAppIssue(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status in ['unread', 'resolved'];
      allow delete: if isBootstrappedAdmin() && isValidId(issueId);
    }

    match /adminFeedbackThreads/{threadId} {
      allow get: if isSignedIn() && isValidId(threadId) && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(threadId)
        && isValidAdminFeedbackThread(incoming(), threadId)
        && incoming().uid == request.auth.uid
        && incoming().lastSenderRole == 'user'
        && incoming().unreadByAdmin == true
        && incoming().unreadByUser == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(threadId)
        && isValidAdminFeedbackThread(incoming(), threadId)
        && incoming().uid == existing().uid
        && incoming().threadId == existing().threadId
        && incoming().pageScope == existing().pageScope
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByUser', 'updatedAt'])
            && incoming().lastSenderRole in ['user', existing().lastSenderRole]
          )
          ||
          (
            isBootstrappedAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByUser', 'updatedAt'])
          )
        );
      allow delete: if isBootstrappedAdmin() && isValidId(threadId);

      match /messages/{messageId} {
        allow get: if isVerifiedUser() && isValidId(threadId) && isValidId(messageId) && (existing().threadOwnerUid == request.auth.uid || isBootstrappedAdmin());
        allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().threadOwnerUid == request.auth.uid);
        allow create: if isVerifiedUser()
          && isValidId(threadId)
          && isValidId(messageId)
          && isValidAdminFeedbackMessage(incoming(), threadId)
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/adminFeedbackThreads/$(threadId))
          && getAfter(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data.uid == incoming().threadOwnerUid
          && getAfter(/databases/$(database)/documents/adminFeedbackThreads/$(threadId)).data.pageScope == incoming().pageScope
          && (
            (incoming().senderRole == 'user' && incoming().threadOwnerUid == request.auth.uid)
            || (incoming().senderRole == 'admin' && isBootstrappedAdmin())
          );
        allow update: if false;
        allow delete: if isBootstrappedAdmin() && isValidId(threadId) && isValidId(messageId);
      }
    }

    match /communityMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId);
      allow list: if isVerifiedUser() && existing().roomId in ['general', 'studio', 'salon'];
      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidCommunityMessage(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && (
          incoming().senderRole == 'user'
          || (incoming().senderRole == 'admin' && isBootstrappedAdmin())
        );
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(messageId) && (existing().uid == request.auth.uid || isBootstrappedAdmin());
    }

    match /siteReviews/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().rating >= 1;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidSiteReview(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidSiteReview(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName', 'authorPhotoUrl', 'rating', 'pageTag', 'comment', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
    }

    match /salonQueues/{dateId} {
      allow get: if isSignedIn() && isValidDateStr(dateId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidDateStr(dateId)
        && isValidSalonQueueSummary(incoming(), dateId)
        && incoming().totalSerials == 1
        && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().lastBookingId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().lastBookingId)).data.serialNumber == 1
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().lastBookingId)).data.bookingDate == dateId;
      allow update: if isVerifiedUser()
        && isValidDateStr(dateId)
        && isValidSalonQueueSummary(incoming(), dateId)
        && incoming().bookingDate == existing().bookingDate
        && incoming().totalSerials == existing().totalSerials + 1
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['totalSerials', 'lastBookingId', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().lastBookingId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().lastBookingId)).data.serialNumber == existing().totalSerials + 1
        && getAfter(/databases/$(database)/documents/salonBookings/$(incoming().lastBookingId)).data.bookingDate == dateId;
      allow delete: if false;

      match /tickets/{bookingId} {
        allow get: if isSignedIn() && isValidDateStr(dateId) && isValidId(bookingId);
        allow list: if isSignedIn() && existing().serialNumber >= 1;
        allow create: if isVerifiedUser()
          && isValidDateStr(dateId)
          && isValidId(bookingId)
          && isValidSalonQueueTicket(incoming(), dateId, bookingId)
          && incoming().uid == request.auth.uid
          && incoming().status == 'pending'
          && incoming().hasCompletionSignature == false
          && !('completionSignerName' in incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && getAfter(/databases/$(database)/documents/salonBookings/$(bookingId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/salonBookings/$(bookingId)).data.bookingDate == dateId
          && getAfter(/databases/$(database)/documents/salonBookings/$(bookingId)).data.serialNumber == incoming().serialNumber;
        allow update: if isVerifiedUser()
          && isValidDateStr(dateId)
          && isValidId(bookingId)
          && isValidSalonQueueTicket(incoming(), dateId, bookingId)
          && incoming().bookingId == existing().bookingId
          && incoming().uid == existing().uid
          && incoming().bookingDate == existing().bookingDate
          && incoming().serialNumber == existing().serialNumber
          && incoming().serviceKey == existing().serviceKey
          && incoming().timeSlot == existing().timeSlot
          && incoming().slotMinutes == existing().slotMinutes
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              isBootstrappedAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'hasCompletionSignature', 'completionSignerName', 'updatedAt'
              ])
            )
            || (
              existing().uid == request.auth.uid
              && existing().status in ['pending', 'confirmed']
              && incoming().status == 'cancelled'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
            || (
              existing().uid == request.auth.uid
              && existing().status in ['confirmed', 'completed']
              && incoming().status == 'completed'
              && incoming().hasCompletionSignature == true
              && 'completionSignerName' in incoming()
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'hasCompletionSignature', 'completionSignerName', 'updatedAt'
              ])
            )
          );
        allow delete: if isBootstrappedAdmin() && isValidDateStr(dateId) && isValidId(bookingId);
      }
    }
  }
}
